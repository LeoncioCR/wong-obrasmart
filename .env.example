# Copia a .env.local y completa los valores (no se versiona).

# Next.js / Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# KitObra IA (Groq) - solo se lee en el servidor, nunca en el frontend
GROQ_API_KEY=
# Opcional: modelo de Groq (por defecto openai/gpt-oss-120b)
# GROQ_MODEL=

# WhatsApp
# NEXT_PUBLIC_WHATSAPP_NUMBER=